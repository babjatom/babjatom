{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash .cursor/hooks/guard-shell.sh",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "bash .cursor/hooks/guard-reads.sh",
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash .cursor/hooks/scan-prompt.sh",
        "failClosed": true
      }
    ]
  }
}
